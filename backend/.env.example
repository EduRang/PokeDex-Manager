# ---- Obligatorias ----
MONGO_URI=mongodb://localhost:27017/pokedex
JWT_SECRET=change_me_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# ---- Opcionales (si se omiten, se usa el valor mostrado) ----
PORT=5000
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_MINUTES=30
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_SPRITES_URL=https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon
COOKIE_SAMESITE=strict

# ---- Desarrollo local ----
# Por defecto la cookie de sesión es Secure (solo HTTPS). En local todo va por
# http://, así que hace falta desactivarlo. En producción debe ser TRUE
COOKIE_SECURE=false
